# Runtime services — required in every deployed environment.
# Use the existing Neon production connection only in production.
DATABASE_URL=

# Keeps the current Vercel Blob media available during the Hetzner migration.
BLOB_READ_WRITE_TOKEN=

# Build-time only: a GitHub token with read:packages, used by Coolify to
# install @andershauch/auth and @andershauch/mail. Do not expose it at runtime.
NPM_TOKEN=

# Auth Plugin (@andershauch/auth) — add when Neon Auth is enabled for this
# environment. Generate a different cookie secret for every environment.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# SMTP Plugin (@andershauch/mail) — server-side only.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_NAME=Pollinator
MAIL_FROM_ADDRESS=hello@mail.hansendjurhuus.dk
MAIL_REPLY_TO=info@hansendjurhuus.dk

# Leave unset in development and preview unless a deliberate email test is
# required. The mail package simulates sends outside production by default.
# ALLOW_DEV_EMAILS=true
